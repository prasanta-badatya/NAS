# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-secret-key

DJANGO_DEBUG=False

# Comma-separated — add your Cloudflare tunnel domain here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<your-tunnel-domain>.trycloudflare.com

# Comma-separated — the origin the Angular app is served from
CORS_ALLOWED_ORIGINS=https://<your-tunnel-domain>.trycloudflare.com
